generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ResourceType {
  SLIDE
  READING
  SYLLABUS
  ASSIGNMENT
  DATASET
  VIDEO
  LINK
  OTHER
}

enum PublicationType {
  BOOK
  JOURNAL_ARTICLE
  BOOK_CHAPTER
  ADDITIONAL_RESEARCH_OUTPUT
}

enum PublicationStatus {
  PUBLISHED
  FORTHCOMING
  PREPRINT
  ERRATUM
  REVIEW
}

model AdminUser {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  username     String         @unique
  passwordHash String
  role         AdminRole      @default(ADMIN)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash   String    @unique
  adminUserId String    @db.ObjectId
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
}

model Post {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  titleId           String
  titleEn           String?
  slugId            String        @unique
  slugEn            String?       @unique
  excerptId         String?
  excerptEn         String?
  coverImage        String?
  contentId         Json
  contentEn         Json?
  topics            String[]
  status            ContentStatus @default(DRAFT)
  canonicalExternal String?
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([topics])
}

model AgendaItem {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  titleId         String
  titleEn         String?
  slugId          String        @unique
  slugEn          String?       @unique
  descriptionId   String
  descriptionEn   String?
  startsAt        DateTime
  endsAt          DateTime?
  locationLabelId String?
  locationLabelEn String?
  externalUrl     String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, startsAt])
}

model StudyMaterial {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  titleId         String
  titleEn         String?
  slugId          String        @unique
  slugEn          String?       @unique
  descriptionId   String
  descriptionEn   String?
  courseId        String
  courseEn        String?
  topicId         String?
  topicEn         String?
  resourceType    ResourceType
  semester        String?
  academicYear    String?
  tagsId          String[]
  tagsEn          String[]
  assetId         String?       @db.ObjectId
  externalUrl     String?
  downloadAllowed Boolean       @default(false)
  pinned          Boolean       @default(false)
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, pinned, updatedAt])
  @@index([courseId])
  @@index([courseEn])
  @@index([topicId])
  @@index([topicEn])
  @@index([resourceType])
  @@index([academicYear, semester])
}

model Publication {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  type              PublicationType
  title             String
  authors           String[]
  editors           String[]          @default([])
  year              Int
  dateLabel         String?
  containerTitle    String?
  venue             String?
  publisher         String?
  publicationPlace  String?
  volume            String?
  issue             String?
  seriesNumber      String?
  pages             String?
  doi               String?
  externalUrl       String?
  status            PublicationStatus @default(PUBLISHED)
  contentStatus     ContentStatus     @default(DRAFT)
  abstract          String?
  featured          Boolean           @default(false)
  cardImageId       String?           @db.ObjectId
  cardImage         MediaAsset?       @relation("PublicationCardImage", fields: [cardImageId], references: [id])
  coverImage        String?
  sourceName        String
  sourceUrl         String?
  sourceCheckedAt   DateTime?
  alternateUrls     String[]
  sourceNote        String
  sourceFingerprint String?           @unique
  rawCitation       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([type, year])
  @@index([status])
  @@index([contentStatus])
  @@index([featured])
  @@index([cardImageId])
}

model MediaAsset {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  storageKey       String        @unique
  url              String
  fileName         String
  mimeType         String
  size             Int
  altTextId        String?
  altTextEn        String?
  rightsNote       String
  publicationCards Publication[] @relation("PublicationCardImage")
  createdAt        DateTime      @default(now())
}
