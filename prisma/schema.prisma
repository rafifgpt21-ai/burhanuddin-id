generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentKind {
  HOMEPAGE
  POST
  AGENDA
  MATERIAL
  PUBLICATION
}

enum ResourceType {
  SLIDE
  READING
  SYLLABUS
  ASSIGNMENT
  DATASET
  VIDEO
  LINK
  OTHER
}

enum PublicationType {
  BOOK
  JOURNAL_ARTICLE
  BOOK_CHAPTER
  ADDITIONAL_RESEARCH_OUTPUT
}

enum PublicationStatus {
  PUBLISHED
  FORTHCOMING
  PREPRINT
  ERRATUM
  REVIEW
}

model AdminUser {
  id           String         @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  username     String         @unique
  passwordHash String
  role         AdminRole      @default(ADMIN)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash   String    @unique
  adminUserId String    @db.ObjectId
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
}

model Post {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  titleId               String
  titleEn               String?
  slugId                String        @unique
  slugEn                String?       @unique
  excerptId             String?
  excerptEn             String?
  coverImage            String?
  contentId             Json
  contentEn             Json?
  topics                String[]
  pinned                Boolean       @default(false)
  status                ContentStatus @default(DRAFT)
  canonicalExternal     String?
  publishedSnapshot     Json?
  draftVersion          Int           @default(1)
  publishedVersion      Int?
  hasUnpublishedChanges Boolean       @default(false)
  lastEditedById        String?       @db.ObjectId
  publishedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([topics])
}

model AgendaItem {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  titleId               String
  titleEn               String?
  slugId                String        @unique
  slugEn                String?       @unique
  descriptionId         String
  descriptionEn         String?
  startsAt              DateTime
  endsAt                DateTime?
  locationLabelId       String?
  locationLabelEn       String?
  externalUrl           String?
  status                ContentStatus @default(DRAFT)
  publishedSnapshot     Json?
  draftVersion          Int           @default(1)
  publishedVersion      Int?
  hasUnpublishedChanges Boolean       @default(false)
  lastEditedById        String?       @db.ObjectId
  publishedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status, startsAt])
}

model StudyMaterial {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  titleId               String
  titleEn               String?
  slugId                String        @unique
  slugEn                String?       @unique
  descriptionId         String
  descriptionEn         String?
  courseId              String
  courseEn              String?
  topicId               String?
  topicEn               String?
  resourceType          ResourceType
  semester              String?
  academicYear          String?
  tagsId                String[]
  tagsEn                String[]
  assetId               String?       @db.ObjectId
  asset                 MediaAsset?   @relation("MaterialAsset", fields: [assetId], references: [id])
  externalUrl           String?
  downloadAllowed       Boolean       @default(false)
  pinned                Boolean       @default(false)
  status                ContentStatus @default(DRAFT)
  publishedSnapshot     Json?
  draftVersion          Int           @default(1)
  publishedVersion      Int?
  hasUnpublishedChanges Boolean       @default(false)
  lastEditedById        String?       @db.ObjectId
  publishedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status, pinned, updatedAt])
  @@index([courseId])
  @@index([courseEn])
  @@index([topicId])
  @@index([topicEn])
  @@index([resourceType])
  @@index([academicYear, semester])
}

model Publication {
  id                    String            @id @default(auto()) @map("_id") @db.ObjectId
  type                  PublicationType
  title                 String
  authors               String[]
  editors               String[]          @default([])
  year                  Int
  dateLabel             String?
  containerTitle        String?
  venue                 String?
  publisher             String?
  publicationPlace      String?
  volume                String?
  issue                 String?
  seriesNumber          String?
  pages                 String?
  doi                   String?
  externalUrl           String?
  status                PublicationStatus @default(PUBLISHED)
  contentStatus         ContentStatus     @default(DRAFT)
  abstract              String?
  featured              Boolean           @default(false)
  homepageOrder         Int?
  cardImageId           String?           @db.ObjectId
  cardImage             MediaAsset?       @relation("PublicationCardImage", fields: [cardImageId], references: [id])
  coverImage            String?
  sourceName            String
  sourceUrl             String?
  sourceCheckedAt       DateTime?
  alternateUrls         String[]
  sourceNote            String
  sourceFingerprint     String?           @unique
  rawCitation           String?
  publishedSnapshot     Json?
  draftVersion          Int               @default(1)
  publishedVersion      Int?
  hasUnpublishedChanges Boolean           @default(false)
  lastEditedById        String?           @db.ObjectId
  publishedAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([type, year])
  @@index([status])
  @@index([contentStatus])
  @@index([featured])
  @@index([homepageOrder])
  @@index([cardImageId])
}

model MediaAsset {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  storageKey       String          @unique
  url              String
  fileName         String
  mimeType         String
  size             Int
  altTextId        String?
  altTextEn        String?
  rightsNote       String
  publicationCards Publication[]   @relation("PublicationCardImage")
  materials        StudyMaterial[] @relation("MaterialAsset")
  createdAt        DateTime        @default(now())
}

model HomepageContent {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  key                   String        @unique @default("main")
  payload               Json
  status                ContentStatus @default(DRAFT)
  publishedSnapshot     Json?
  draftVersion          Int           @default(1)
  publishedVersion      Int?
  hasUnpublishedChanges Boolean       @default(false)
  lastEditedById        String?       @db.ObjectId
  publishedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model ContentRevision {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  kind          ContentKind
  recordId      String
  version       Int
  snapshot      Json
  publishedById String?     @db.ObjectId
  createdAt     DateTime    @default(now())

  @@unique([kind, recordId, version])
  @@index([kind, recordId, createdAt])
}

model SlugRedirect {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  kind      ContentKind
  locale    String
  oldSlug   String
  recordId  String
  createdAt DateTime    @default(now())

  @@unique([kind, locale, oldSlug])
  @@index([kind, recordId])
}
